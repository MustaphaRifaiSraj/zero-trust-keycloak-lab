# Copy this file to .env and replace every CHANGE_ME with your own values.
# Use only letters, numbers and dashes in passwords.
COMPOSE_FILE=docker-compose.yml:docker-compose.apps.yml:docker-compose.ldap.yml
VM_IP=CHANGE_ME
KC_ADMIN_USER=acmeadmin
KC_ADMIN_PASSWORD=CHANGE_ME
COOKIE_SECRET=CHANGE_ME_32_CHARACTERS
HR_CLIENT_SECRET=CHANGE_ME
ENG_CLIENT_SECRET=CHANGE_ME
FIN_CLIENT_SECRET=CHANGE_ME
LDAP_ADMIN_PASSWORD=CHANGE_ME
